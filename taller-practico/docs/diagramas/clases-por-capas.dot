digraph clases {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.5, ranksep=0.9, compound=true, pad=0.3];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#2c3e50", arrowsize=0.9];

  subgraph cluster_pres {
    label="CAPA DE PRESENTACIÓN"; style="rounded,dashed"; color="#7f8c8d"; fontcolor="#7f8c8d";
    PrestamoController [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dde9f5"><b>PrestamoController</b><br/><i>«RestController»</i></td></tr>
        <tr><td align="left" balign="left">- prestamoService: PrestamoService</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ registrar(request: PrestamoRequest): PrestamoResponse<br/>+ listar(): List&lt;PrestamoResponse&gt;</td></tr>
      </table>>];
  }
  subgraph cluster_dto {
    label="DTO (objetos de entrada y salida)"; style="rounded,dashed"; color="#7f8c8d"; fontcolor="#7f8c8d";
    PrestamoRequest [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#e8f0e0"><b>PrestamoRequest</b><br/><i>«record / DTO»</i></td></tr>
        <tr><td align="left" balign="left">+ estudianteId: Long {NotNull}<br/>+ libroId: Long {NotNull}</td></tr>
      </table>>];
    PrestamoResponse [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#e8f0e0"><b>PrestamoResponse</b><br/><i>«record / DTO»</i></td></tr>
        <tr><td align="left" balign="left">+ id: Long<br/>+ estudiante: String<br/>+ libro: String<br/>+ fechaPrestamo: LocalDate<br/>+ fechaDevolucion: LocalDate</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ desde(p: Prestamo): PrestamoResponse</td></tr>
      </table>>];
  }

  subgraph cluster_neg {
    label="CAPA DE NEGOCIO"; style="rounded,dashed"; color="#7f8c8d"; fontcolor="#7f8c8d";
    PrestamoService [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dde9f5"><b>PrestamoService</b><br/><i>«Service»</i></td></tr>
        <tr><td align="left" balign="left">- prestamoRepository: PrestamoRepository<br/>- estudianteRepository: EstudianteRepository<br/>- libroRepository: LibroRepository</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ registrarPrestamo(request: PrestamoRequest): PrestamoResponse «Transactional»<br/>+ listarPrestamos(): List&lt;PrestamoResponse&gt;</td></tr>
      </table>>];
  }

  subgraph cluster_datos {
    label="CAPA DE ACCESO A DATOS"; style="rounded,dashed"; color="#7f8c8d"; fontcolor="#7f8c8d";
    JpaRepository [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#f5ecd9"><i>«interface»</i><br/><b>JpaRepository&lt;T, ID&gt;</b></td></tr>
        <tr><td align="left" balign="left">+ save(entidad: T): T<br/>+ findById(id: ID): Optional&lt;T&gt;<br/>+ findAll(): List&lt;T&gt;</td></tr>
      </table>>];
    PrestamoRepository [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#f5ecd9"><i>«interface»</i><br/><b>PrestamoRepository</b></td></tr>
        <tr><td align="left" balign="left">(hereda save, findAll)</td></tr>
      </table>>];
    EstudianteRepository [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#f5ecd9"><i>«interface»</i><br/><b>EstudianteRepository</b></td></tr>
        <tr><td align="left" balign="left">(hereda findById)</td></tr>
      </table>>];
    LibroRepository [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#f5ecd9"><i>«interface»</i><br/><b>LibroRepository</b></td></tr>
        <tr><td align="left" balign="left">+ buscarParaPrestar(id: Long): Optional&lt;Libro&gt;</td></tr>
      </table>>];
  }

  subgraph cluster_dom {
    label="MODELO DE DOMINIO (entidades, no es una capa de ejecución)"; style="rounded,dashed"; color="#7f8c8d"; fontcolor="#7f8c8d";
    Estudiante [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dde9f5"><b>Estudiante</b><br/><i>«Entity»</i></td></tr>
        <tr><td align="left" balign="left">- id: Long<br/>- nombre: String<br/>- correo: String</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ getId(): Long<br/>+ getNombre(): String</td></tr>
      </table>>];
    Libro [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dde9f5"><b>Libro</b><br/><i>«Entity»</i></td></tr>
        <tr><td align="left" balign="left">- id: Long<br/>- titulo: String<br/>- disponible: boolean</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ isDisponible(): boolean<br/>+ marcarPrestado(): void<br/>+ marcarDisponible(): void</td></tr>
      </table>>];
    Prestamo [label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dde9f5"><b>Prestamo</b><br/><i>«Entity»</i></td></tr>
        <tr><td align="left" balign="left">- id: Long<br/>- fechaPrestamo: LocalDate<br/>- fechaDevolucion: LocalDate [0..1]<br/>- estudiante: Estudiante<br/>- libro: Libro</td></tr>
        <tr><td border="1" sides="t" align="left" balign="left">+ Prestamo(estudiante, libro, fecha)<br/>+ getEstudiante(): Estudiante<br/>+ getLibro(): Libro</td></tr>
      </table>>];
  }

  // Asociaciones estructurales entre capas (el origen guarda un atributo con la referencia)
  PrestamoController -> PrestamoService [taillabel="1", headlabel="1", labeldistance=2.2, label="usa", arrowhead=vee];
  PrestamoService -> PrestamoRepository   [taillabel="1", headlabel="1", labeldistance=2.2, arrowhead=vee];
  PrestamoService -> EstudianteRepository [taillabel="1", headlabel="1", labeldistance=2.2, arrowhead=vee];
  PrestamoService -> LibroRepository      [taillabel="1", headlabel="1", labeldistance=2.2, arrowhead=vee];

  // Dependencias (uso puntual, sin atributo): línea punteada
  PrestamoController -> PrestamoRequest  [style=dashed, arrowhead=vee, label="«use»"];
  PrestamoController -> PrestamoResponse [style=dashed, arrowhead=vee, label="«use»"];
  PrestamoService -> PrestamoRequest  [style=dashed, arrowhead=vee, label="«use»", constraint=false];
  PrestamoService -> PrestamoResponse [style=dashed, arrowhead=vee, label="«create»", constraint=false];

  // Generalización entre interfaces (extends)
  PrestamoRepository   -> JpaRepository [arrowhead=empty];
  EstudianteRepository -> JpaRepository [arrowhead=empty];
  LibroRepository      -> JpaRepository [arrowhead=empty];

  // Repositorios gestionan entidades (dependencia)
  PrestamoRepository   -> Prestamo   [style=dashed, arrowhead=vee, label="«manages»"];
  EstudianteRepository -> Estudiante [style=dashed, arrowhead=vee, label="«manages»"];
  LibroRepository      -> Libro      [style=dashed, arrowhead=vee, label="«manages»"];

  // Asociaciones del dominio (Prestamo guarda las referencias)
  { rank=same; Estudiante; Prestamo; Libro; }
  Prestamo -> Estudiante [taillabel="0..*", headlabel="1", labeldistance=2.5, arrowhead=vee, label="historial"];
  Prestamo -> Libro      [taillabel="0..*", headlabel="1", labeldistance=2.5, arrowhead=vee, label="historial"];

  nota [shape=note, fontsize=10, label="R5: de los préstamos históricos de un Libro,\lsolo uno puede estar activo (fechaDevolucion vacía).\lSe garantiza con Libro.disponible dentro de la\ltransacción del servicio.\l", style=filled, fillcolor="#fffbe6"];
  nota2 [shape=note, fontsize=10, label="Spring Data genera en tiempo de ejecución\lla implementación de cada repositorio.\l", style=filled, fillcolor="#fffbe6"];
  nota -> Prestamo [style=dotted, arrowhead=none];
  nota2 -> JpaRepository [style=dotted, arrowhead=none];
}
